# Excel_sense_v2 - Environment Variables Configuration Template
# Copy this file to .env and fill in your keys.

# ==============================================================================
# Groq API Configuration (Primary LLM Reasoning)
# ==============================================================================
# Enter your Groq API key below
GROQ_API_KEY=

# Default Groq model (llama-3.3-70b-versatile, llama-3.1-70b-versatile, etc.)
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Alternative / Fallback LLM Settings
# ==============================================================================
# Force deterministic mode even if an API key is present (1 = true, 0 = false)
TALK_TO_DATA_DISABLE_LLM=0

# Optional alternative Anthropic Claude key
ANTHROPIC_API_KEY=

# ==============================================================================
# Server & Web UI (Streamlit)
# ==============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_THEME_BASE=light

# ==============================================================================
# Data & Cache Configuration
# ==============================================================================
TALK_TO_DATA_DIR=data/csv
TALK_TO_DATA_CACHE_ENABLED=1
LOG_LEVEL=INFO
